APP_NAME="Swiss-Belinn SKA Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Database (Default: SQLite persistent container volume)
DB_CONNECTION=sqlite
# For MySQL uncomment and configure below:
# DB_CONNECTION=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_DATABASE=sipu_db
# DB_USERNAME=sipu_user
# DB_PASSWORD=your_strong_password

# Sessions & Cache (Database backed)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database

# Queue & Filesystem
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

# Mail Configuration (Configure your SMTP provider)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Ports configuration (Docker host bindings)
HTTP_PORT=80
HTTPS_PORT=443

# Optional Integrations
GEMINI_API_KEY=
